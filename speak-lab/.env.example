# Transcription (word timestamps + confidence). Free starter credit: https://console.deepgram.com
DEEPGRAM_API_KEY=


# Analysis LLM: "gemini" (default) or "groq" -- both have free tiers
LLM_PROVIDER=gemini
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq key (if LLM_PROVIDER=groq): https://console.groq.com/keys
GROQ_API_KEY=
# Optional model override (defaults: gemini-3.8-flash / llama-3.3-70b-versatile)
LLM_MODEL=
# If one provider is overloaded, the other is used automatically (set both keys for best reliability)
